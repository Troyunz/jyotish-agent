# ============================================================
#  Copy this file to  .env  and fill in only what you use.
#  The agent works fully offline with just Ollama - keys are optional.
# ============================================================

# Google Gemini (free tier, no credit card) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: point at a different Ollama server (default is local)
# OLLAMA_HOST=http://localhost:11434
